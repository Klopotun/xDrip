// ── Запусти эту функцию из редактора чтобы обновить каталог ──────────
function reimportProducts() {
  var sh = getSheet('_products');
  // Clear existing
  var lastRow = sh.getLastRow();
  if (lastRow > 1) sh.deleteRows(2, lastRow - 1);
  
