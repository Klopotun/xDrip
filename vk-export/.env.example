# Copy this file to .env and fill in your values.
# Never commit .env to version control!

# VK community access token with "messages" permission.
# How to get it: see README.md → "Получение токена".
VK_TOKEN=your_community_access_token_here

# Numeric ID of your VK community (without the minus sign).
# Example: for vk.com/club123456789 use 123456789
GROUP_ID=123456789

# VK API version (leave as-is unless you know what you're doing)
VK_API_VERSION=5.131

# Folder where export files will be written (relative to project root)
EXPORT_DIR=export

# Seconds to pause between API requests (default 0.34 ≈ 3 req/s)
REQUEST_DELAY=0.34

# How many times to retry on error before giving up
RETRY_COUNT=3

# Base delay in seconds between retries (multiplied by attempt number)
RETRY_DELAY=5.0
